{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "workspaces": {
    ".": {
      "entry": ["tests/security/*.ts", "tests/e2e/**/*.ts", "scripts/*.mjs", "scripts/*.ts", "scripts/eslint-rules/*.mjs"],
      "project": ["src/**/*.{ts,tsx}", "scripts/**/*.{mjs,ts}", "tests/**/*.ts"],
      "ignore": ["src/data/database.types.ts", "src/vendor/**"]
    },
    "worker": {
      "project": ["src/**/*.ts"]
    }
  }
}
