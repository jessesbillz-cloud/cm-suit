{
  "name": "cm-suite",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "engines": { "node": ">=22" },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit -p tsconfig.json && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p worker/tsconfig.json",
    "lint": "eslint .",
    "knip": "knip",
    "hygiene": "node scripts/hygiene.mjs",
    "test:unit": "vitest run",
    "test:db": "supabase test db",
    "test:security": "tsx tests/security/anon-probe.ts && tsx tests/security/role-probe.ts",
    "test:e2e": "playwright test",
    "check": "npm run typecheck && npm run lint && npm run knip && npm run hygiene && npm run test:unit && npm run test:db && npm run test:security && npm run test:e2e",
    "gen:types": "supabase gen types typescript --local --schema public > src/data/database.types.ts",
    "clean": "node scripts/clean.mjs",
    "prepare": "husky"
  },
  "dependencies": {
    "@sentry/react": "^8.40.0",
    "@supabase/supabase-js": "^2.47.0",
    "@tanstack/react-query": "^5.62.0",
    "@tanstack/react-router": "^1.87.0",
    "date-fns": "^4.1.0",
    "date-fns-tz": "^3.2.0",
    "lucide-react": "^0.468.0",
    "pdf-lib": "^1.17.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tus-js-client": "^4.2.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@playwright/test": "^1.49.1",
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.17",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.17.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "globals": "^15.14.0",
    "husky": "^9.1.7",
    "knip": "^5.41.1",
    "postcss": "^8.4.49",
    "supabase": "^2.1.1",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.2",
    "vite": "^6.0.5",
    "vite-plugin-pwa": "^0.21.1",
    "vitest": "^2.1.8"
  }
}
